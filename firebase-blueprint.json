{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Portfolio project item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "shortDesc": { "type": "string" },
        "fullDesc": { "type": "string" },
        "tags": { "type": "string" },
        "image": { "type": "string" },
        "demoUrl": { "type": "string" },
        "githubUrl": { "type": "string" },
        "featured": { "type": "boolean" },
        "architecture": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "category", "shortDesc"]
    },
    "EducationItem": {
      "title": "EducationItem",
      "description": "Educational background and internship experience",
      "type": "object",
      "properties": {
        "institution": { "type": "string" },
        "level": { "type": "string" },
        "location": { "type": "string" },
        "period": { "type": "string" },
        "description": { "type": "string" },
        "skillsFocus": { "type": "string" },
        "iconType": { "type": "string" },
        "badge": { "type": "string" },
        "image": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["institution", "level", "period"]
    },
    "ProfileConfig": {
      "title": "ProfileConfig",
      "description": "Developer profile and settings",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "headlineRole": { "type": "string" },
        "tagline": { "type": "string" },
        "location": { "type": "string" },
        "statusBadge": { "type": "string" },
        "photoUrl": { "type": "string" },
        "yearsOfExp": { "type": "string" },
        "projectsCompleted": { "type": "string" },
        "satisfactionRate": { "type": "string" },
        "bioShort": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" }
      },
      "required": ["name", "headlineRole"]
    },
    "SocialPlatform": {
      "title": "SocialPlatform",
      "description": "Social media channels and direct contact routes",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "iconKey": { "type": "string" },
        "url": { "type": "string" },
        "username": { "type": "string" },
        "badge": { "type": "string" },
        "color": { "type": "string" },
        "active": { "type": "boolean" },
        "order": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["name", "url", "iconKey"]
    },
    "NfcCardRecord": {
      "title": "NfcCardRecord",
      "description": "Registered 13.56 MHz NFC smart card keys",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "cardUid": { "type": "string" },
        "chipType": { "type": "string" },
        "authKeyHash": { "type": "string" },
        "status": { "type": "string" },
        "linkedAt": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["label", "cardUid"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Broadcast news and announcements",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "pinned": { "type": "boolean" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "content"]
    },
    "MessageInquiry": {
      "title": "MessageInquiry",
      "description": "Contact form submissions from visitors",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["name", "email", "message"]
    },
    "AnalyticsData": {
      "title": "AnalyticsData",
      "description": "System analytics tracking counts",
      "type": "object",
      "properties": {
        "totalVisits": { "type": "number" },
        "projectClicks": { "type": "number" },
        "contactClicks": { "type": "number" },
        "nfcTaps": { "type": "number" },
        "devLogins": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/socials/{socialId}": {
      "schema": "SocialPlatform",
      "description": "Contact links and social media channels"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio projects collection"
    },
    "/education/{educationId}": {
      "schema": "EducationItem",
      "description": "Education and internship history collection"
    },
    "/profile/{profileId}": {
      "schema": "ProfileConfig",
      "description": "Profile settings document"
    },
    "/broadcasts/{broadcastId}": {
      "schema": "Announcement",
      "description": "Announcements collection"
    },
    "/nfcCards/{cardId}": {
      "schema": "NfcCardRecord",
      "description": "NFC smart cards authentication registry"
    },
    "/inquiries/{inquiryId}": {
      "schema": "MessageInquiry",
      "description": "Contact form messages collection"
    },
    "/analytics/{analyticsId}": {
      "schema": "AnalyticsData",
      "description": "Telemetry and analytics statistics"
    }
  }
}
